# ==============================================================================
# Meridian Packaging - B2B Corporate Gifting Assistant Environment Configuration
# ==============================================================================

# Server Configuration
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:3000

# Google Gemini AI Configuration
# Required for live generative responses.
# Default: gemini-flash-lite-latest (always uses the latest production Flash-Lite model).
# Also supports specific models such as: gemini-3.8-flash, gemini-3.5-flash-lite.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-lite-latest"
MAX_AI_TOKENS=350
MAX_HISTORY_TURNS=10
MAX_MESSAGE_LENGTH=1000

# Company Information & WhatsApp Desk
# Digits only (with country code, no + or spaces), e.g. 918867719798
COMPANY_NAME="KappaBoxes"
COMPANY_WHATSAPP_NUMBER="918867719798"
SALES_EMAIL="info@kappaboxes.com"
SALES_PHONE="+91 8867719798"

# Database Configuration (Supabase PostgreSQL)
# Optional for local development/testing (uses in-memory repository with seed data).
# Provide these in production to persist to Supabase.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Cloudflare Turnstile Bot Protection (Optional)
# If provided, verifies Turnstile tokens on enquiry and chat requests.
TURNSTILE_SECRET_KEY=""

# Rate Limiting Configuration
RATE_LIMIT_IP_MAX=60
RATE_LIMIT_SESSION_MAX=25
RATE_LIMIT_SESSION_DAILY_MAX=75

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173"
